@model PrintShop.Models.AdminReportViewModel
@{
    ViewData["Title"] = "Relatórios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateTime.Today;
    var from = Model.From?.ToString("yyyy-MM-dd") ?? "";
    var to = Model.To?.ToString("yyyy-MM-dd") ?? "";
    string Period(DateTime start, DateTime end) => $"/Admin/Reports?from={start:yyyy-MM-dd}&to={end:yyyy-MM-dd}";
    var periodLabel = Model.From.HasValue || Model.To.HasValue
        ? $"{Model.From?.ToString("dd/MM/yyyy") ?? "início"} a {Model.To?.ToString("dd/MM/yyyy") ?? "hoje"}"
        : "todo o período";
}

<div class="page-header">
    <h1>Relatórios</h1>
    <p>Resumo operacional dos pedidos de @periodLabel.</p>
</div>

<form action="/Admin/Reports" method="get" class="queue-filter report-filter">
    <div class="field">
        <label for="from">De</label>
        <input type="date" name="from" id="from" class="text-input" value="@from" />
    </div>
    <div class="field">
        <label for="to">Até</label>
        <input type="date" name="to" id="to" class="text-input" value="@to" />
    </div>
    <button type="submit" class="btn-primary">Filtrar</button>
    <a href="/Admin/ExportOrders?from=@from&to=@to" class="btn-ghost">Exportar CSV</a>
</form>
<div class="report-presets">
    <a href="@Period(today, today)">Hoje</a>
    <a href="@Period(today.AddDays(-6), today)">Últimos 7 dias</a>
    <a href="@Period(new DateTime(today.Year, today.Month, 1), today)">Este mês</a>
    <a href="@Period(new DateTime(today.Year, today.Month, 1).AddMonths(-1), new DateTime(today.Year, today.Month, 1).AddDays(-1))">Mês passado</a>
    <a href="/Admin/Reports">Tudo</a>
</div>

<div class="queue-stats">
    <div class="stat report-primary-stat">
        <strong>R$ @Model.CompletedRevenue.ToString("F2")</strong>
        <span>Faturamento concluído</span>
    </div>
    <div class="stat">
        <strong>R$ @Model.TotalRegisteredRevenue.ToString("F2")</strong>
        <span>Total registrado</span>
    </div>
    <div class="stat">
        <strong>R$ @Model.ActiveRevenue.ToString("F2")</strong>
        <span>Pedidos ativos</span>
    </div>
    <div class="stat">
        <strong>@Model.TotalOrders</strong>
        <span>Pedidos registrados</span>
    </div>
    <div class="stat">
        <strong>@Model.PrintedPages</strong>
        <span>Páginas para impressão</span>
    </div>
    <div class="stat">
        <strong>@Model.TotalPages</strong>
        <span>Páginas enviadas</span>
    </div>
    <div class="stat">
        <strong>@Model.TotalFiles</strong>
        <span>Arquivos enviados</span>
    </div>
    <div class="stat">
        <strong>@Model.PendingOrders</strong>
        <span>Aguardando pagamento</span>
    </div>
</div>

<div class="review-layout reports-layout">
    <div class="review-main">
    <div class="review-card">
        <h2>Pedidos por status</h2>
        @if (!Model.StatusBreakdown.Any())
        {
            <p class="muted">Sem dados.</p>
        }
        else
        {
            <div class="report-list">
                @foreach (var item in Model.StatusBreakdown)
                {
                    <div class="report-row">
                        <span>@item.Label</span>
                        <strong>@item.Count</strong>
                    </div>
                }
            </div>
        }
    </div>

    <div class="review-card">
        <h2>Tipo de impressão</h2>
        @if (!Model.ColorBreakdown.Any())
        {
            <p class="muted">Sem dados.</p>
        }
        else
        {
            <div class="report-list">
                @foreach (var item in Model.ColorBreakdown)
                {
                    <div class="report-row">
                        <span>@item.Label</span>
                        <strong>@item.Count</strong>
                    </div>
                }
            </div>
        }
    </div>
    </div>

    <div class="price-sidebar">
    <div class="price-card reports-summary">
        <h2>Tipo de papel</h2>
        @if (!Model.PaperBreakdown.Any())
        {
            <p class="muted">Sem dados.</p>
        }
        else
        {
            <div class="report-list">
                @foreach (var item in Model.PaperBreakdown)
                {
                    <div class="report-row">
                        <span>@item.Label</span>
                        <strong>@item.Count</strong>
                    </div>
                }
            </div>
        }

        <h2 class="report-subtitle">Forma de pagamento</h2>
        @if (!Model.PaymentBreakdown.Any())
        {
            <p class="muted">Sem dados.</p>
        }
        else
        {
            <div class="report-list">
                @foreach (var item in Model.PaymentBreakdown)
                {
                    <div class="report-row">
                        <span>@item.Label</span>
                        <strong>@item.Count</strong>
                    </div>
                }
            </div>
        }

        <h2 class="report-subtitle">Resumo</h2>
        <div class="report-list">
            <div class="report-row">
                <span>Prontos</span>
                <strong>@Model.ReadyOrders</strong>
            </div>
            <div class="report-row">
                <span>Cancelados</span>
                <strong>@Model.CancelledOrders</strong>
            </div>
            <div class="report-row">
                <span>Pagos</span>
                <strong>@Model.PaidOrders</strong>
            </div>
        </div>
    </div>
    </div>
</div>

<div class="queue-table-wrapper reports-table">
    @if (!Model.TopCustomers.Any())
    {
        <div class="empty-state">
            <h2>Clientes que mais imprimem</h2>
            <p>Nenhum cliente registrado ainda.</p>
        </div>
    }
    else
    {
        <div class="reports-table-title">
            <h2>Clientes que mais imprimem</h2>
            <span>@Model.TopCustomers.Count cliente(s)</span>
        </div>
        <table class="queue-table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Telefone</th>
                    <th>Pedidos</th>
                    <th>Páginas</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.TopCustomers)
                {
                    <tr>
                        <td><strong>@customer.Name</strong></td>
                        <td>@customer.Phone</td>
                        <td>@customer.Orders</td>
                        <td>@customer.Pages</td>
                        <td><strong>R$ @customer.Amount.ToString("F2")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
