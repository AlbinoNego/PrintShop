<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PrintShop</RootNamespace>
		<WebRoot>wwwroot</WebRoot>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="PrintShop.Agent\**\*.cs" />
		<!-- O agente e um projeto a parte; sem isto suas pastas bin entram aninhadas na saida. -->
		<Content Remove="PrintShop.Agent\**" />
		<None Remove="PrintShop.Agent\**" />
		<!-- Configuracao local e segredos nunca vao para o pacote publicado. -->
		<Content Update="appsettings.json;appsettings.Local.json;appsettings.example.json;launchSettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
		<!-- Pacote padrao: restaura em qualquer maquina e traz o e_sqlite3 nativo por plataforma. -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
		<!-- Projeto de testes fica fora do site. -->
		<Compile Remove="PrintShop.Tests\**" />
		<Content Remove="PrintShop.Tests\**" />
		<None Remove="PrintShop.Tests\**" />
	</ItemGroup>

	<!-- Copia o wwwroot para o bin automaticamente -->
	<Target Name="CopyWwwroot" AfterTargets="Build">
		<ItemGroup>
			<WwwrootFiles Include="$(ProjectDir)wwwroot\**\*.*" />
		</ItemGroup>
		<Copy
		  SourceFiles="@(WwwrootFiles)"
		  DestinationFiles="@(WwwrootFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true" />
	</Target>

</Project>
